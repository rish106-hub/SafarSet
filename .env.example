# Required for accounts and customer data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Required only by the admin seed command. Never expose the password publicly.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=

# Optional live flight status. Keep this server-only.
PROVIDER_MODE=live
AVIATIONSTACK_API_KEY=

# Optional Google Calendar read-only connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional AI Gateway. Without this, saved-trip, policy, and status routing still works.
AI_GATEWAY_API_KEY=
AI_AGENT_MODEL=google/gemini-2.5-flash
AI_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# Optional. Recovery and in-app confirmation work without these values.
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
